# ==============================================================================
# SECUREVAULT BACKEND CONFIGURATION TEMPLATE
# Copy to backend/.env and replace placeholders with your actual secure values.
# ==============================================================================

# Runtime environment (development / production)
NODE_ENV=development

# Server port
PORT=5002

# MongoDB connection URI (Atlas or local instance)
MONGODB_URI=mongodb://127.0.0.1:27017/securevault
MONGODB_DB_NAME=securevault

# Authentication & Cryptographic Keys (Required - Min 32 characters each)
JWT_SECRET=your_jwt_secret_min_32_characters_here
ENCRYPTION_MASTER_KEY=your_aes_256_master_key_32_chars!

# Frontend Origin for CORS allowlist
FRONTEND_URL=http://localhost:5173

# Demo accounts seeding (default: false; set to true only in development/demo mode)
ENABLE_DEMO_ACCOUNTS=false
