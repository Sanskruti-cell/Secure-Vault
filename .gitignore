# ==============================================================================
# SECUREVAULT – GIT IGNORE CONFIGURATION
# ==============================================================================

# Dependencies
node_modules/
backend/node_modules/
venv/
.venv/
backend/ml/venv/
backend/ml/.venv/
__pycache__/
*.py[cod]
*$py.class

# Environment & Secrets (Never commit credentials)
.env
.env.local
.env.*.local
backend/.env
backend/.env.local
backend/ml/.env
backend/ml/.env.local
!.env.example
!backend/.env.example
!backend/ml/.env.example

# Build outputs & caches
dist/
dist-ssr/
build/
.vite/
*.tsbuildinfo
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
SecureVault/
SecureVault*.zip

# Physical Storage Nodes & Shards (Generated at runtime)
storage/**
!storage/**/
!storage/**/.gitkeep
backend/storage/**
!backend/storage/**/
!backend/storage/**/.gitkeep
*.shard.*
chrome-test-profile/
scratch/
test_output.txt
*.zip

# Subprojects / Unrelated local directories
portfolio/
smart_coupon_agent/

# OS and Editor artifacts
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
*.sublime-project
*.sublime-workspace
Thumbs.db
